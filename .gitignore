# ═══════════════════════════════════════════════════════════════════════════
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

tmp/
temp/
.cache/

# Laravel runtime (hqba/backend)
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/
bootstrap/cache/

# ═══════════════════════════════════════════════════════════════════════════
