# ═══════════════════════════════════════════════════════════════════════════
#  Secrets — never commit any of these
# ═══════════════════════════════════════════════════════════════════════════
.env
.env.*
*.env
!.env.example
!**/.env.example

*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*_rsa
*_ed25519
id_rsa*
.ssh/

# Database dumps and exports — may contain customer or employee data
*.sql.gz
*.dump
*.bak
*.backup
dump.sql
backup*.sql

# Captured auth state
auth-state.json
storageState.json
cookies.json

# ═══════════════════════════════════════════════════════════════════════════
#  Dependencies and build output
# ═══════════════════════════════════════════════════════════════════════════
node_modules/
vendor/
.pnp
.pnp.js

.next/
out/
dist/
build/
.turbo/
.swc/

# Prisma's generated client is produced by `prisma generate`
**/src/generated/
**/generated/prisma/

# ═══════════════════════════════════════════════════════════════════════════
#  Test and coverage artefacts
# ═══════════════════════════════════════════════════════════════════════════
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
.nyc_output/

